digraph wafers_add_flow {
  graph [
    rankdir=TB,
    labelloc=t,
    label="wafers add flow",
    fontname="Helvetica",
    fontsize=20
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=12,
    fillcolor="#f7f7f7",
    color="#555555"
  ];

  edge [
    fontname="Helvetica",
    fontsize=11,
    color="#555555"
  ];

  start [shape=oval, label="wafers add <name>\n--at <mountpoint>\n--branch <branch>", fillcolor="#ecf7ff"];
  validate [label="validate name, branch,\nand repo"];
  clean_check [shape=diamond, label="base worktree\nclean?"];
  fail_dirty [label="fail:\nbase repo dirty", fillcolor="#ffecec"];
  owner_check [shape=diamond, label="branch already\nowned by wafer?"];
  fail_owned [label="fail:\nbranch already owned", fillcolor="#ffecec"];
  branch_check [shape=diamond, label="branch exists?"];
  ancestor_check [shape=diamond, label="base HEAD ancestor\nof branch tip?"];
  fail_ancestor [label="fail:\nbranch does not descend\nfrom base HEAD", fillcolor="#ffecec"];
  plan_existing [label="plan existing branch\nlast_commit = branch tip"];
  plan_new [label="plan new branch\nlast_commit = base HEAD"];
  mountpoint_check [label="resolve mountpoint\nand ensure empty"];
  create_state [label="create wafer state\nupperdir, workdir, index path"];
  mount [label="fuse-overlayfs mount\nlower=base repo\nupper=wafer upper"];
  hide_git [label="remove mount/.git\ncreates wafer-local whiteout"];
  git_check [shape=diamond, label="Git discoverable\ninside mount?"];
  fail_git [label="cleanup + fail:\nmountpoint inside another Git repo", fillcolor="#ffecec"];
  create_check [shape=diamond, label="planned branch\ncreate?"];
  replay_check [shape=diamond, label="existing branch\nahead of base?"];
  replay [label="replay base..branch\ninto mounted view"];
  verify_tree [shape=diamond, label="mounted tree\nmatches branch?"];
  fail_replay [label="cleanup + fail:\nreplay mismatch", fillcolor="#ffecec"];
  create_branch [label="create local branch\nat base HEAD"];
  save_meta [label="write meta.json\nlast_commit = expected tip"];
  done [shape=oval, label="wafer ready", fillcolor="#ecffef"];

  start -> validate -> clean_check;
  clean_check -> fail_dirty [label="no"];
  clean_check -> owner_check [label="yes"];
  owner_check -> fail_owned [label="yes"];
  owner_check -> branch_check [label="no"];
  branch_check -> ancestor_check [label="yes"];
  ancestor_check -> fail_ancestor [label="no"];
  ancestor_check -> plan_existing [label="yes"];
  branch_check -> plan_new [label="no"];
  plan_existing -> mountpoint_check;
  plan_new -> mountpoint_check;
  mountpoint_check -> create_state;
  create_state -> mount -> hide_git -> git_check;
  git_check -> fail_git [label="yes"];
  git_check -> create_check [label="no"];
  create_check -> create_branch [label="yes"];
  create_check -> replay_check [label="no"];
  replay_check -> replay [label="yes"];
  replay -> verify_tree;
  verify_tree -> fail_replay [label="no"];
  verify_tree -> save_meta [label="yes"];
  replay_check -> save_meta [label="no"];
  create_branch -> save_meta -> done;
}
